# Package and plugin-source validation for `install-software`. The manifest is
# synced data, so it is untrusted input: nothing from it reaches a shell or
# pacman unchecked.
PKG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._+-]{0,127}$")
SOURCE_RE = re.compile(r"^(https://|http://|ssh://|git://|git@)[^\s]+$")


# --- small helpers ---------------------------------------------------------

def expand(p) -> Path:
    return Path(os.path.expanduser(str(p)))


def to_tilde(p) -> str:
    s = str(p)
    home = str(HOME)
    return "~" + s[len(home):] if s == home or s.startswith(home + "/") else s


def run(cmd, cwd=None, check=True, env=None, timeout=None):
    proc = subprocess.run(
        cmd, cwd=cwd, env=env, text=True, timeout=timeout,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
    )
    if check and proc.returncode != 0:
        raise RuntimeError(f"{' '.join(map(str, cmd))}\n{proc.stdout.strip()}")
    return proc


def have(binary: str) -> bool:
    return shutil.which(binary) is not None


def slug(text: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip("-") or "item"


def stamp() -> str:
    return time.strftime("%Y%m%d-%H%M%S")


def hostname() -> str:
    return re.sub(r"[^A-Za-z0-9-]+", "-", socket.gethostname() or "host")


def local_root(p: Path) -> Path:
    """Resolve a top-level symlink so we sync the folder's contents.

    `~/Documents -> /data/Documents` is common, and `rsync -a` would copy the
    symlink itself, storing a dangling link and no data. Resolving keeps the
    link in place on both ends: reads and writes go to its target.
    """
    try:
        return p.resolve()
    except OSError:
        return p


def home_rel(p: Path) -> str:
    return str(p.relative_to(HOME))


def default_state() -> dict:
    return {
        "version": VERSION,
        "git": {"remote": "", "branch": "main"},
        "gdrive": {"remote": "", "delete": False},
        "watch": {"enabled": False, "pullMinutes": 10, "lastPass": "",
                  "lastResult": ""},
        # Kept so an upgrade can migrate a machine that had the old interval
        # timer switched on; nothing writes it any more.
        "auto": {"enabled": False, "intervalMinutes": 30},
        "apps": {},
        "hidden": [],
        "lastSync": {"at": "", "ok": True, "message": "never synced"},
    }


def load_state() -> dict:
    state = default_state()
    if STATE_FILE.exists():
        try:
            loaded = json.loads(STATE_FILE.read_text())
        except (OSError, json.JSONDecodeError):
            loaded = {}
        for key in ("version", "git", "gdrive", "watch", "auto", "apps", "hidden",
                    "lastSync"):
            if key in loaded:
                if isinstance(state.get(key), dict) and isinstance(loaded[key], dict):
                    state[key].update(loaded[key])
                else:
                    state[key] = loaded[key]
        if "watch" not in loaded and loaded.get("auto", {}).get("enabled"):
            # Migrate: the old interval timer becomes the watcher.
            state["watch"]["enabled"] = True
        if int(loaded.get("version", 0) or 0) < VERSION:
            # Defaults fill in whatever an older file lacks, so the in-memory
            # state is already the current shape.
            state["version"] = VERSION
    return state


def save_state(state: dict) -> None:
    """Atomic write that survives a crash mid-write.

    The state file holds the remotes and every toggle, and a truncated file
    silently reads back as defaults, so it is fsynced before the rename and the
    previous good copy is kept as `.bak`.
    """
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".json.tmp")
    payload = json.dumps(state, indent=2, sort_keys=False) + "\n"
    with open(tmp, "w") as fh:
        fh.write(payload)
        fh.flush()
        os.fsync(fh.fileno())
    if STATE_FILE.exists():
        try:
            shutil.copy2(STATE_FILE, STATE_FILE.with_suffix(".json.bak"))
        except OSError:
            pass
    tmp.replace(STATE_FILE)


# --- detection -------------------------------------------------------------

def name_for(entry: str, kind: str) -> str:
    if entry in PRETTY:
        return PRETTY[entry]
    if kind == "dotfile" and entry in DOTFILES:
        return DOTFILES[entry]
    stem = entry.lstrip(".").replace("_", "-")
    return " ".join(w.capitalize() if w.islower() else w for w in stem.split("-"))


def is_secret(rel: str) -> bool:
    return any(rel == s or rel.startswith(s + "/") for s in SECRETS)


def detect() -> dict:
    """Walk ~/.config and the home dotfiles; return {id: candidate}."""
    found: dict[str, dict] = {}

    if (HOME / ".config").is_dir():
        for child in sorted((HOME / ".config").iterdir()):
            name = child.name
            if name in SKIP_CONFIG or name in OMARCHY_DIRS or name.startswith("."):
                continue
            rel = f".config/{name}"
            if is_secret(rel):
                continue
            if not child.is_dir() and child.suffix not in ("", ".conf", ".toml", ".json"):
                if name not in PRETTY:
                    continue
            risky = name in RISKY
            found[name] = {
                "name": name_for(name, "config"),
                "kind": "config",
                "paths": [f"~/{rel}"],
                "target": "git",
                "enabled": not risky,
                "risky": risky,
                "note": RISKY.get(name, ""),
            }

    for dot, label in DOTFILES.items():
        if (HOME / dot).exists():
            cid = dot.lstrip(".")
            found[cid] = {
                "name": label,
                "kind": "dotfile",
                "paths": [f"~/{dot}"],
                "target": "git",
                "enabled": True,
                "risky": False,
                "note": "",
            }

    for group in OMARCHY:
        rel = group["paths"][0][2:]  # strip "~/"
        if (HOME / rel).exists():
            found[group["id"]] = {
                "name": group["name"],
                "kind": "omarchy",
                "paths": group["paths"],
                "target": "git",
                "enabled": True,
                "risky": False,
                "note": "",
                "exclude": group["exclude"],
            }

    for dirname, label in COMMON_DIRS.items():
        folder = HOME / dirname
        # List it whenever it exists, even if empty, so the Drive-defaulting
        # folders are always visible to manage rather than appearing only once
        # something happens to be in them.
        if not folder.is_dir():
            continue
        note = "Personal files — defaults to Google Drive."
        if folder.is_symlink():
            note = f"Personal files — symlinked to {local_root(folder)}."
        found[f"personal-{dirname}"] = {
            "name": label,
            "kind": "personal",
            "paths": [f"~/{dirname}"],
            "target": "gdrive",
            "enabled": True,
            "risky": False,
            "note": note,
        }

    return found


def merge_detected(state: dict) -> int:
    """Add newly-detected apps, keep choices for ones already known."""
    known = state["apps"]
    hidden = set(state.get("hidden", []))
    detected = detect()
    changed = 0
    for cid, candidate in detected.items():
        if cid in hidden:
            continue
        if cid in known:
            known[cid]["name"] = candidate["name"]
            known[cid]["paths"] = candidate["paths"]
            known[cid]["kind"] = candidate["kind"]
            if candidate.get("note"):
                known[cid]["note"] = candidate["note"]
            if "exclude" in candidate:
                known[cid]["exclude"] = candidate["exclude"]
        else:
            known[cid] = candidate
            changed += 1
    # Drop entries that detection no longer offers, but keep hand-added ones.
    for cid in list(known):
        if cid not in detected and known[cid].get("kind") != "custom":
            del known[cid]
            changed += 1
    state["apps"] = dict(sorted(known.items(), key=lambda kv: kv[1]["name"].lower()))
    return changed


# --- fingerprints and plans ------------------------------------------------
#
# A fingerprint is what we compare between passes:
#
#   ("f", size, mtime)   a regular file
#   ("d",)               a directory
#   ("l", target)        a symlink (copied as a link, never followed)
#
# Comparing fingerprints instead of running rsync blind is what makes the
# reconciler safe: it can tell which side changed, which side deleted, and when
# both changed, instead of letting the newer mtime silently win.

def fingerprint(path: Path):
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if os.path.islink(str(path)):
        try:
            return ("l", os.readlink(str(path)))
        except OSError:
            return ("l", "")
    if os.path.isdir(str(path)):
        return ("d",)
    return ("f", st.st_size, int(st.st_mtime_ns))


def digest(path: Path) -> str | None:
    """Content hash, read only when size and time cannot settle identity.

    Timestamps are how the fast path compares files, but they lie on a mounted
    drive (rounding) and in the git store (a checkout rewrites them). When two
    files are the same size and the question is "did both sides really end up
    with the same bytes?", guessing wrong throws away one machine's version, so
    it is worth reading them.
    """
    hasher = hashlib.sha256()
    try:
        with path.open("rb") as handle:
            for block in iter(lambda: handle.read(1 << 20), b""):
                hasher.update(block)
    except OSError:
        return None
    return hasher.hexdigest()


def same(a, b, tolerance: int = DRIVE_TOLERANCE) -> bool:
    if a is None or b is None:
        return a is b
    if a[0] != b[0]:
        return False
    if a[0] == "f":
        return a[1] == b[1] and abs(a[2] - b[2]) <= tolerance
    return a == b


def excluded(rel: str, name: str, patterns) -> bool:
    for pattern in patterns:
        if pattern.startswith("/"):
            anchored = "/" + rel
            if fnmatch.fnmatch(anchored, pattern) or anchored.startswith(pattern + "/"):
                return True
        elif fnmatch.fnmatch(name, pattern):
            return True
    return False


def is_excluded_path(rel: str, patterns, allow_secrets: bool = False) -> bool:
    if excluded(rel, Path(rel).name, patterns):
        return True
    return not allow_secrets and excluded(rel, Path(rel).name, SECRET_FILES)


def scan_dir(root: Path, patterns, allow_secrets: bool = False,
             max_entries: int = 200000):
    """Relative path -> fingerprint for everything we are willing to copy."""
    out: dict[str, tuple] = {}
    if not root.is_dir():
        return out
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        here = Path(dirpath)
        rel_dir = str(here.relative_to(root))
        keep = []
        for d in dirnames:
            rel = d if rel_dir == "." else f"{rel_dir}/{d}"
            if is_excluded_path(rel, patterns, allow_secrets):
                continue
            if (here / d).is_symlink():
                # Never walk into a linked directory: that leaves the synced
                # tree, and can loop.
                out[rel] = fingerprint(here / d)
                continue
            keep.append(d)
            out[rel] = ("d",)
        dirnames[:] = keep
        if rel_dir != ".":
            out[rel_dir] = ("d",)
        for f in filenames:
            rel = f if rel_dir == "." else f"{rel_dir}/{f}"
            if is_excluded_path(rel, patterns, allow_secrets):
                continue
            fp = fingerprint(here / f)
            if fp is not None:
                out[rel] = fp
        if len(out) > max_entries:
            raise RuntimeError(
                f"{to_tilde(root)} has more than {max_entries} entries — "
                "narrow it down or add excludes")
    return out


def pair_bases(local: Path, remote: Path):
    """(local base, remote base, is_dir) — how one pair is shaped on disk.

    A directory is its own base, so relative paths inside it are the shared
    namespace. A single file uses its parent as the base and keeps its name as
    the relative path — and the shape comes from whichever side exists, so a
    backend copy that has not been created yet is still treated as a directory
    when the local side is one.
    """
    lfp, rfp = fingerprint(local), fingerprint(remote)
    if lfp is not None:
        is_dir = lfp[0] == "d"
    elif rfp is not None:
        is_dir = rfp[0] == "d"
    else:
        is_dir = True
    return (local if is_dir else local.parent,
            remote if is_dir else remote.parent, is_dir)


class Plan:
    """What a reconcile pass intends to do, before it does anything."""

    def __init__(self):
        self.push: list[str] = []           # local -> backend
        self.pull: list[str] = []           # backend -> local
        self.delete_remote: list[str] = []  # removed here, gone there too
        self.delete_local: list[str] = []   # removed there, gone here too
        self.conflicts: list[str] = []      # changed on both sides
        self.kept: list[str] = []           # deletion not propagated
        self.same: list[str] = []
        self.overwrite_local: list[str] = []  # a resume: backend version wins


def make_plan(local: dict, remote: dict, base_local: dict, base_remote: dict,
              delete: bool, prefer: str | None = None,
              remote_slack: int = DRIVE_TOLERANCE,
              content_equal=None, force: str | None = None,
              unpublished: bool = False) -> Plan:
    """Three-way compare. `prefer` only decides a no-baseline disagreement.

    `force="backend"` is a resume: the baseline is ignored and the backend — the
    snapshot just checked out — wins every disagreement. `unpublished` says the
    remote never accepted what the last pass reconciled, so a remote-side change
    is kept as a conflict copy instead of overwriting local work.
    """
    plan = Plan()

    def identical(rel: str, a, b) -> bool:
        """Do the two sides hold the same bytes?

        Equal fingerprints say yes for free. Otherwise, same size and a close
        stamp is not proof, so the contents decide when the caller can read
        them; if it cannot, the answer is no and both versions are kept.
        """
        if a is None or b is None:
            return a is b
        if a == b:
            return True
        if a[0] != "f" or b[0] != "f" or a[1] != b[1]:
            return False
        return bool(content_equal and content_equal(rel))

    for rel in sorted(set(local) | set(remote)):
        l = local.get(rel)
        r = remote.get(rel)
        bl = base_local.get(rel)
        br = base_remote.get(rel)
        known = rel in base_local or rel in base_remote

        if force == "backend":
            # A resume. The snapshot is the truth, so every difference resolves
            # its way: what the snapshot has is written back, what it does not
            # have is removed, and a differing local file is moved to the trash
            # rather than dropped, which keeps the restore reversible.
            if l is None and r is None:
                continue
            if l is None:
                plan.pull.append(rel)
            elif r is None:
                plan.delete_local.append(rel)
            elif identical(rel, l, r):
                plan.same.append(rel)
            else:
                plan.overwrite_local.append(rel)
            continue

        if l is not None and r is not None:
            if not known:
                # First pass for this pair on this machine. The backend holds
                # the setup being restored, so it wins — and the local version
                # is preserved rather than dropped.
                if identical(rel, l, r):
                    plan.same.append(rel)
                elif prefer == "local":
                    plan.push.append(rel)
                else:
                    plan.pull.append(rel)
                    plan.conflicts.append(rel)
                continue
            # Compare each side against the baseline, not against each other:
            # the baseline is the only record of what was true last time.
            local_changed = bl is None or not same(l, bl, LOCAL_TOLERANCE)
            remote_changed = br is None or not same(r, br, remote_slack)
            if local_changed and remote_changed:
                if identical(rel, l, r):
                    plan.same.append(rel)     # both sides really hold the same bytes
                else:
                    plan.conflicts.append(rel)
            elif local_changed:
                plan.push.append(rel)
            elif remote_changed:
                # With content still unpublished the remote's side of the
                # baseline is not trustworthy: keep both rather than let the
                # remote's copy replace local work it has never seen.
                (plan.conflicts if unpublished else plan.pull).append(rel)
            else:
                plan.same.append(rel)
            continue

        if l is not None and r is None:
            # The backend copy is gone: it was deleted on the other machine.
            if unpublished:
                # The remote's side of the baseline cannot be trusted yet, so
                # keep the local file and publish it again rather than removing it.
                plan.push.append(rel)
            elif known and bl is not None and same(l, bl, LOCAL_TOLERANCE):
                (plan.delete_local if delete else plan.kept).append(rel)
            else:
                plan.push.append(rel)
            continue

        if l is None and r is not None:
            # The local copy is gone: it was deleted here.
            if known and br is not None and same(r, br, remote_slack):
                (plan.delete_remote if delete else plan.kept).append(rel)
            else:
                plan.pull.append(rel)
            continue
    return plan


# --- applying a plan -------------------------------------------------------

def rsync_copy(src_root: Path, dst_root: Path, rels, extra=()) -> None:
    """Copy the named paths (files, dirs, links) with rsync.

    The list goes over stdin NUL-separated (`--from0`) so names with spaces or
    newlines cannot be mangled into other paths.
    """
    if not rels:
        return
    if not have("rsync"):
        raise RuntimeError("rsync is not installed")
    dst_root.mkdir(parents=True, exist_ok=True)
    payload = b"".join(rel.encode("utf-8", "surrogateescape") + b"\0" for rel in rels)
    # --ignore-times: the decision to copy was already made by comparing
    # fingerprints, and rsync's own quick check only compares whole seconds. A
    # same-size edit saved in the same second as the last sync would otherwise
    # be listed, reported as sent, and never actually copied.
    cmd = ["rsync", "-a", "--ignore-times", "--mkpath", "--from0", "--files-from=-",
           *extra, str(src_root) + "/", str(dst_root) + "/"]
    proc = subprocess.run(cmd, input=payload, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT)
    if proc.returncode != 0:
        raise RuntimeError("rsync failed: " + proc.stdout.decode("utf-8", "replace").strip())


def conflict_name(name: str) -> str:
    p = Path(name)
    return f"{p.stem}.conflict-{hostname()}-{stamp()}{p.suffix}"


def conflict_copies_of(directory: Path, name: str) -> list[Path]:
    """Every conflict copy kept beside `directory/name`."""
    p = Path(name)
    return sorted(directory.glob(f"{p.stem}.conflict-*{p.suffix}"))


def existing_conflict_copy(src: Path, directory: Path, name: str) -> Path | None:
    """A copy beside the winner that already holds exactly these bytes.

    The same version can lose more than once — a daemon that rewrites its file
    the same way on every start, a pass repeated after a failed push — and a fresh
    copy per pass is just noise. Identical content means no second copy is needed.
    """
    if not src.is_file():
        return None
    needle = digest(src)
    for candidate in conflict_copies_of(directory, name):
        if candidate.is_file() and digest(candidate) == needle:
            return candidate
    return None


def save_conflict_copy(src: Path, dest: Path) -> Path:
    """Keep the version that is about to lose, next to the winner."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    if src.is_dir():
        shutil.copytree(src, dest, symlinks=True, dirs_exist_ok=True)
    else:
        shutil.copy2(src, dest, follow_symlinks=False)
    return dest


def trash(path: Path, rel: str, side: str, app: str) -> None:
    """Move a file the sync removed into the trash, with an index entry."""
    target = TRASH_DIR / stamp() / side / rel
    target.parent.mkdir(parents=True, exist_ok=True)
    try:
        shutil.move(str(path), str(target))
    except (OSError, shutil.Error):
        if path.is_dir():
            shutil.rmtree(path, ignore_errors=True)
        else:
            try:
                path.unlink()
            except OSError:
                pass
        return
    index = TRASH_DIR / "index.json"
    try:
        entries = json.loads(index.read_text()) if index.exists() else []
    except (OSError, json.JSONDecodeError):
        entries = []
    entries.append({
        "at": time.strftime("%Y-%m-%d %H:%M"),
        "app": app,
        "side": side,
        "rel": rel,
        # The whole point of the trash is restoring the file where it was, and
        # `rel` is relative to the synced pair, not to $HOME.
        "path": str(path),
        "trashed": str(target),
    })
    index.parent.mkdir(parents=True, exist_ok=True)
    index.write_text(json.dumps(entries[-500:], indent=2) + "\n")


def baseline_path(key: str) -> Path:
    return BASELINE_DIR / f"{slug(key)}.json"


def baseline_exists(key: str) -> bool:
    return baseline_path(key).exists()


def load_baseline(key: str) -> tuple[dict, dict, bool]:
    """What both sides held after the last pass, and whether it was published.

    `unpublished` means the last pass reconciled content that the remote never
    accepted (the push was refused, or the remote was unreachable). While that is
    true the next pass is deliberately conservative: it keeps both versions
    instead of letting the remote's copy win, because the local side holds
    content the remote has never seen.
    """
    path = baseline_path(key)
    if not path.exists():
        return {}, {}, False
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}, {}, False
    def to_fp(raw):
        return {k: tuple(v) for k, v in raw.items()}
    return (to_fp(data.get("local", {})), to_fp(data.get("remote", {})),
            bool(data.get("unpublished")))


def save_baseline(key: str, local: dict, remote: dict, published: bool = True) -> None:
    BASELINE_DIR.mkdir(parents=True, exist_ok=True)
    path = baseline_path(key)
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps({
        "updated": time.strftime("%Y-%m-%d %H:%M:%S"),
        "unpublished": not published,
        "local": {k: list(v) for k, v in local.items()},
        "remote": {k: list(v) for k, v in remote.items()},
    }, indent=1) + "\n")
    tmp.replace(path)


class PairResult:
    def __init__(self):
        self.pushed = self.pulled = self.deleted = self.kept = 0
        self.conflicts: list[str] = []
        self.notes: list[str] = []
        self.errors: list[str] = []
        # (key, local, remote) for a git pair: the caller saves it once the
        # content has actually been published, never before.
        self.pending_baseline = None


def reconcile_pair(key: str, label: str, local: Path, remote: Path,
                   patterns, delete: bool, dry: bool = False,
                   prefer: str | None = None,
                   force: str | None = None,
                   allow_secrets: bool = False,
                   single_name: str | None = None,
                   remote_slack: int = DRIVE_TOLERANCE,
                   defer_baseline: bool = False) -> PairResult:
    """Bring one local path and its backend copy back into agreement."""
    result = PairResult()
    local = Path(local)
    remote = Path(remote)
    if not local.exists() and not remote.exists():
        return result

    lfp, rfp = fingerprint(local), fingerprint(remote)
    if lfp is not None and rfp is not None and lfp[0] != rfp[0]:
        kind = lambda fp: "directory" if fp[0] == "d" else "file"  # noqa: E731
        result.errors.append(
            f"{label}: {to_tilde(local)} is a {kind(lfp)} but the backend copy is a "
            f"{kind(rfp)} — leaving both alone")
        return result

    base_local, base_remote, unpublished = load_baseline(key)
    first_sync = not baseline_exists(key)

    local_base, remote_base, is_dir = pair_bases(local, remote)
    name = single_name or local.name
    if is_dir:
        local_scan = scan_dir(local_base, patterns, allow_secrets)
        remote_scan = scan_dir(remote_base, patterns, allow_secrets)
    else:
        local_scan = {name: lfp} if lfp is not None else {}
        remote_scan = {name: rfp} if rfp is not None else {}
    plan = make_plan(local_scan, remote_scan, base_local, base_remote, delete, prefer,
                     remote_slack=remote_slack, force=force,
                     unpublished=unpublished,
                     content_equal=lambda rel: (
                         (left := digest(local_base / rel)) is not None
                         and left == digest(remote_base / rel)))

    if dry:
        for rel in plan.push:
            print(f"  would push {rel}")
        for rel in plan.pull:
            print(f"  would pull {rel}")
        for rel in plan.delete_remote + plan.delete_local:
            print(f"  would delete {rel}")
        for rel in plan.conflicts:
            print(f"  conflict {rel}")
        for rel in plan.overwrite_local:
            print(f"  would restore {rel}")
        result.pushed = len(plan.push)
        result.pulled = len(plan.pull) + len(plan.overwrite_local)
        result.deleted = len(plan.delete_remote) + len(plan.delete_local)
        result.conflicts = list(plan.conflicts)
        result.kept = len(plan.kept)
        return result

    # 1. Conflicts first, so both the winner and the loser are known before
    #    anything is copied. The local copy wins in place; the backend's version
    #    is kept beside it (or collected under the data directory on a first
    #    sync, where dozens of default configs can disagree at once). The copy is
    #    never pushed: it is this machine's recovery artefact, and publishing it
    #    made every conflict a new file — and a new conflict — elsewhere.
    for rel in plan.conflicts:
        if first_sync:
            # The backend wins here (this machine is being restored), so the
            # copy worth keeping is the one already on disk.
            src = local_base / rel
            dest = CONFLICTS_DIR / f"first-sync-{stamp()}" / rel
        else:
            # The local copy wins in place; keep the backend's version beside it.
            src = remote_base / rel
            directory = local_base / Path(rel).parent
            dest = existing_conflict_copy(src, directory, Path(rel).name)
            if dest is None:
                dest = directory / conflict_name(Path(rel).name)
        if not src.exists() or dest.exists():
            continue
        try:
            save_conflict_copy(src, dest)
        except OSError as exc:
            result.errors.append(f"{label}: could not save {rel}: {exc}")

    # 2. Copies. Directories travel as their own entries; rsync creates them.
    #    A conflicted file still pushes the winner, so the other side stops
    #    offering the version it just lost.
    push_rels = list(plan.push)
    if not first_sync:
        push_rels += [rel for rel in plan.conflicts if (local_base / rel).exists()]
    # A resume overwrites the local copy, so what is being replaced goes to the
    # trash first: a restore you regret is still a restore you can undo.
    for rel in plan.overwrite_local:
        target = local_base / rel
        if target.exists():
            trash(target, rel, "local", key)
    pull_rels = list(plan.pull) + list(plan.overwrite_local)
    rsync_copy(local_base, remote_base, push_rels)
    rsync_copy(remote_base, local_base, pull_rels)
    result.pushed += len(push_rels)
    result.pulled += len(pull_rels)
    result.conflicts = list(plan.conflicts)

    # 3. Deletions, to the trash, never unlinked.
    for rel in plan.delete_remote:
        target = remote_base / rel
        if target.exists():
            trash(target, rel, "remote", key)
            result.deleted += 1
    for rel in plan.delete_local:
        target = local_base / rel
        if target.exists():
            trash(target, rel, "local", key)
            result.deleted += 1
    result.kept = len(plan.kept)

    # 4. Baseline: what both sides hold now. rsync -a preserves mtimes, so the
    #    copied fingerprint is the source one.
    if not result.errors:
        new_local = dict(base_local)
        new_remote = dict(base_remote)
        for rel in plan.same:
            fp = local_scan.get(rel) or remote_scan.get(rel)
            new_local[rel] = new_remote[rel] = fp
        for rel in push_rels:
            fp = local_scan.get(rel) or fingerprint(local_base / rel)
            new_local[rel] = new_remote[rel] = fp
        for rel in list(plan.pull) + list(plan.overwrite_local):
            fp = remote_scan.get(rel) or fingerprint(remote_base / rel)
            new_local[rel] = new_remote[rel] = fp
        for rel in plan.delete_remote + plan.delete_local:
            new_local.pop(rel, None)
            new_remote.pop(rel, None)
        for rel in plan.kept:
            new_local[rel] = local_scan.get(rel) or base_local.get(rel)
            new_remote[rel] = remote_scan.get(rel) or base_remote.get(rel)
        # Directories implied by a copied file must exist on both sides too.
        for rel in list(new_local):
            parent = str(Path(rel).parent)
            while parent not in (".", "", "/"):
                if parent not in new_local:
                    new_local[parent] = ("d",)
                    new_remote[parent] = ("d",)
                parent = str(Path(parent).parent)
        if defer_baseline:
            # The caller saves it once the push has landed. A baseline recorded
            # for content the remote never accepted would make the next pass read
            # the local change as a revert by the other machine.
            result.pending_baseline = (key, new_local, new_remote)
        else:
            save_baseline(key, new_local, new_remote)
    return result


# --- software --------------------------------------------------------------
#
# `capture-software` records the Omarchy plugins you have (with their git
# source) and the packages you installed on top of Arch, into a manifest that
# travels with the rest of the config. `install-software` puts them back on a
# fresh machine: plugins clone without privileges; packages are installed
# through a terminal so pacman can ask for a password.
#
# The manifest is *synced data*: a compromised git remote or Drive folder can
# rewrite it. Everything read from it is validated here, and nothing is
# installed without the plan being shown first.

def _omarchy_plugins():
    if not have("omarchy"):
        return []
    proc = run(["omarchy", "plugin", "list", "--json"], check=False)
    if proc.returncode != 0:
        return []
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return []
    return data if isinstance(data, list) else []


def _plugin_remote(pid: str) -> str:
    folder = PLUGIN_DIR / pid
    if not (folder / ".git").exists():
        return ""
    proc = run(["git", "-C", str(folder), "remote", "get-url", "origin"], check=False)
    return proc.stdout.strip() if proc.returncode == 0 else ""


def _pacman(flag: str):
    if not have("pacman"):
        return []
    proc = run(["pacman", flag], check=False)
    if proc.returncode != 0:
        return []
    return [line.strip() for line in proc.stdout.splitlines() if line.strip()]


def valid_package(name: str) -> bool:
    """Package names go to pacman: reject anything that could be a flag."""
    return bool(PKG_RE.match(name or ""))


def valid_source(source: str) -> bool:
    """Plugin sources go to git: only real remotes, never a leading dash."""
    return bool(SOURCE_RE.match(source or ""))


def capture_software() -> dict:
    plugins = []
    for pl in _omarchy_plugins():
        if pl.get("firstParty"):
            continue
        plugins.append({
            "id": pl.get("id", ""),
            "name": pl.get("name", ""),
            "source": _plugin_remote(pl.get("id", "")),
            "enabled": bool(pl.get("enabled")),
        })
    manifest = {
        "capturedAt": time.strftime("%Y-%m-%d %H:%M"),
        "host": socket.gethostname(),
        "plugins": plugins,
        "packages": {"native": _pacman("-Qqen"), "aur": _pacman("-Qqem")},
    }
    # The manifest is synced data. Writing it on every pass — its `capturedAt`
    # always differs — made it a local edit every ten minutes, and a conflict on
    # every pass once the other machine had captured its own. Keep the old file
    # (and its timestamp) unless something that travels actually changed.
    previous = load_manifest()
    if previous is not None and _same_manifest(previous, manifest):
        return previous
    MANIFEST.parent.mkdir(parents=True, exist_ok=True)
    MANIFEST.write_text(json.dumps(manifest, indent=2) + "\n")
    return manifest


def _same_manifest(previous: dict, current: dict) -> bool:
    """Is this the same manifest, apart from when and where it was captured?"""
    ignore = ("capturedAt", "host")
    return ({k: v for k, v in previous.items() if k not in ignore}
            == {k: v for k, v in current.items() if k not in ignore})


def load_manifest():
    if not MANIFEST.exists():
        return None
    try:
        return json.loads(MANIFEST.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def software_summary() -> dict:
    manifest = load_manifest()
    if not manifest:
        return {"captured": False, "plugins": 0, "packages": 0, "capturedAt": ""}
    return {
        "captured": True,
        "plugins": len(manifest.get("plugins", [])),
        "packages": len(manifest["packages"]["native"]) + len(manifest["packages"]["aur"]),
        "capturedAt": manifest.get("capturedAt", ""),
    }


def software_plan() -> dict:
    """What `install-software` would do, with nothing executed."""
    manifest = load_manifest()
    if not manifest:
        return {"ready": False, "reason": "no software manifest yet"}
    installed = {p.get("id") for p in _omarchy_plugins()}
    plugins, rejected_plugins = [], []
    for pl in manifest.get("plugins", []):
        if pl.get("id") in installed:
            continue
        source = pl.get("source", "")
        if not valid_source(source):
            rejected_plugins.append({"id": pl.get("id", ""), "source": source})
            continue
        plugins.append({"id": pl.get("id", ""), "source": source,
                        "enabled": bool(pl.get("enabled"))})
    have_pkgs = set(_pacman("-Qq"))
    packages, rejected_packages = [], []
    for kind in ("native", "aur"):
        for name in manifest["packages"].get(kind, []):
            if name in have_pkgs:
                continue
            if not valid_package(name):
                rejected_packages.append(name)
                continue
            packages.append({"name": name, "kind": kind})
    return {
        "ready": True,
        "capturedAt": manifest.get("capturedAt", ""),
        "host": manifest.get("host", ""),
        "plugins": plugins,
        "packages": packages,
        "rejected": {"plugins": rejected_plugins, "packages": rejected_packages},
    }


def _install_packages(native, aur) -> None:
    steps = []
    if native:
        steps.append("omarchy pkg add " + " ".join(shlex.quote(p) for p in native))
    if aur:
        steps.append("omarchy pkg aur add " + " ".join(shlex.quote(p) for p in aur))
    if not steps:
        return
    script = " && ".join(steps) + "\necho\necho 'Packages done. Press Enter to close.'\nread"
    if sys.stdin.isatty():
        run(["bash", "-lc", script], check=False)
    else:
        # No terminal here (the shell plugin): open one so pacman can prompt.
        run(["omarchy-launch-terminal", "bash", "-lc", script], check=False)


def install_software(dry=False) -> str:
    plan = software_plan()
    if not plan.get("ready"):
        return "no software manifest yet — run Sync on a machine that already has your setup"
    rejected = plan["rejected"]
    if rejected["packages"] or rejected["plugins"]:
        return (f"manifest has {len(rejected['packages'])} package name(s) and "
                f"{len(rejected['plugins'])} plugin source(s) that are not valid — "
                "refusing to install; re-capture on the source machine")

    added = 0
    for pl in plan["plugins"]:
        if dry:
            print(f"  would add plugin {pl['id']} from {pl['source']}")
            continue
        args = ["omarchy", "plugin", "add", pl["source"], "--yes"]
        if pl["enabled"]:
            args.append("--enable")
        run(args, check=False)
        added += 1

    native = [p["name"] for p in plan["packages"] if p["kind"] == "native"]
    aur = [p["name"] for p in plan["packages"] if p["kind"] == "aur"]
    if not dry:
        _install_packages(native, aur)

    parts = [f"{added} plugin(s) installed",
             f"{len(native)} native + {len(aur)} AUR package(s)"]
    return "; ".join(parts)


# --- repositories ----------------------------------------------------------
#
# A read-only inventory of the git repos on the machine: where they are, their
# origin, branch and whether they are dirty or ahead/behind. Mounts and the
# usual heavy trees are skipped so scanning the home directory stays quick.

SCAN_PRUNE = {
    ".cache", ".local", ".npm", ".cargo", ".rustup", ".gradle", ".m2", ".gem",
    ".nvm", ".pyenv", ".conda", ".vscode-server", ".ollama", ".steam", "Steam",
    "node_modules", ".venv", "venv", "env", "target", "build", "dist", ".Trash",
    "snap", ".var", "__pycache__", ".git",
    # big app profiles that are not repos
    "Code", "chromium", "google-chrome", "google-chrome-beta",
    "google-chrome-unstable", "BraveSoftware", "microsoft-edge",
    "microsoft-edge-dev", "mozilla", "opencode", "Proton",
}
SCAN_MAX_DEPTH = 6


def _git(path: Path, *args) -> str:
    proc = run(["git", "-C", str(path), *args], check=False)
    return proc.stdout.strip() if proc.returncode == 0 else ""


def _repo_info(path: Path) -> dict:
    branch = _git(path, "rev-parse", "--abbrev-ref", "HEAD")
    remote = _git(path, "remote", "get-url", "origin")
    dirty = bool(_git(path, "status", "--porcelain"))
    ahead = behind = 0
    upstream = _git(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream:
        counts = _git(path, "rev-list", "--left-right", "--count", "@{u}...HEAD").split()
        if len(counts) == 2:
            behind, ahead = int(counts[0]), int(counts[1])
    return {
        "path": to_tilde(path),
        "name": path.name,
        "branch": branch,
        "remote": remote,
        "dirty": dirty,
        "ahead": ahead,
        "behind": behind,
        "last": _git(path, "log", "-1", "--format=%cr"),
    }


def find_repos():
    state = load_state()
    drive_top = ""
    remote = state["gdrive"].get("remote", "").strip()
    if remote:
        try:
            parts = expand(remote).relative_to(HOME).parts
            if parts:
                drive_top = parts[0]
        except ValueError:
            pass

    repos = {}
    home_depth = len(HOME.parts)

    for root, dirs, _files in os.walk(HOME, topdown=True):
        rootp = Path(root)
        depth = len(rootp.parts) - home_depth
        if depth > SCAN_MAX_DEPTH:
            dirs[:] = []
            continue
        dirs[:] = [
            d for d in dirs
            if d not in SCAN_PRUNE
            and d != drive_top
            and not os.path.ismount(os.path.join(root, d))
            and not os.path.islink(os.path.join(root, d))
        ]
        if ".git" in dirs or (rootp / ".git").exists():
            repos[str(rootp)] = _repo_info(rootp)
            dirs[:] = []  # a repo is a leaf; do not walk its contents

    # The sync backend repo sits under a pruned .local, so add it explicitly.
    if (GIT_DIR / ".git").exists():
        info = _repo_info(GIT_DIR)
        info["name"] = "Config Sync (backend)"
        repos[str(GIT_DIR)] = info

    return sorted(repos.values(), key=lambda r: r["name"].lower())


# --- backends --------------------------------------------------------------

def git_identity(state) -> list[str]:
    return ["-c", f"user.name={os.environ.get('USER', 'configsync')}",
            "-c", "user.email=configsync@localhost"]


def ensure_git_repo(state) -> str:
    if not have("git"):
        raise RuntimeError("git is not installed")
    GIT_DIR.mkdir(parents=True, exist_ok=True)
    if not (GIT_DIR / ".git").exists():
        run(["git", "init", "-q", "-b", state["git"]["branch"]], cwd=GIT_DIR)
    run(["git", "config", "user.name", os.environ.get("USER", "configsync")],
        cwd=GIT_DIR, check=False)
    run(["git", "config", "user.email", "configsync@localhost"], cwd=GIT_DIR, check=False)
    remote = state["git"].get("remote", "").strip()
    if remote:
        run(["git", "remote", "remove", "origin"], cwd=GIT_DIR, check=False)
        run(["git", "remote", "add", "origin", remote], cwd=GIT_DIR)
    return remote


def git_fetch_reset(state) -> str:
    """Bring the store to exactly what the remote holds — no merge, no rebase.

    Git is transport here, not the decision maker: the reconciler owns what the
    content should be, so nothing is ever merged by git. `reset --hard` makes the
    store's tree the remote's tree, including the files the remote no longer has,
    which is what lets the three-way compare read a removal as a removal. A
    watcher copy that landed since the last pass survives as an untracked file:
    it came from the local side, which this pass scans anyway.
    """
    remote = state["git"].get("remote", "").strip()
    if not remote:
        return "local only: the store is the backend"
    branch = state["git"]["branch"]
    if not _git(GIT_DIR, "remote", "get-url", "origin"):
        return "no remote"
    reached = run(["git", "fetch", "-q", "--tags", "origin", branch], cwd=GIT_DIR,
                  check=False).returncode == 0
    note = "" if reached else "could not reach the remote — using the last known state"
    if not _git(GIT_DIR, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}"):
        return note or "the remote has nothing yet"
    run(["git", "reset", "-q", "--hard", f"origin/{branch}"], cwd=GIT_DIR)
    return note


def roll_message(state, report=None, subject: str | None = None) -> str:
    """The one line the rolling commit carries."""
    when = time.strftime("%Y-%m-%d %H:%M")
    if subject:
        return f"{subject} · {when}"
    if report is not None:
        moved = report.pushed + report.pulled + report.deleted
        if moved:
            return (f"configsync {hostname()} · {when} · {moved} file(s) · "
                    f"{report.pushed} sent, {report.pulled} received, "
                    f"{report.deleted} removed")
    return f"configsync {hostname()} · {when}"


def git_roll(state, message: str) -> tuple[bool, str]:
    """Fold the store into the single rolling commit, then publish it.

    The branch holds exactly one commit, always: every pass rewrites it, which is
    what keeps `git log` readable. Snapshots (tags) are the only points that are
    never rewritten. Publishing rewrites the remote's tip too, so the push is
    guarded with --force-with-lease — if another machine pushed after our fetch,
    the push is refused and the next pass reconciles against that content instead.

    Returns (published, note). `published` decides whether a baseline may advance:
    recording one for content the remote never accepted would make the next pass
    read the local change as a revert by the other side.
    """
    remote = state["git"].get("remote", "").strip()
    branch = state["git"]["branch"]
    run(["git", "add", "-A"], cwd=GIT_DIR)
    dirty = bool(_git(GIT_DIR, "status", "--porcelain"))
    count = int(_git(GIT_DIR, "rev-list", "--count", "HEAD") or "0")
    if count > 1:
        # A history from before this design, or one someone else created. Keep
        # the content, keep one commit: the old ones stay reachable through the
        # snapshots that point at them, and through the reflog for a while.
        run(["git", "checkout", "-q", "--orphan", ROLL_BRANCH], cwd=GIT_DIR)
        run(["git", "add", "-A"], cwd=GIT_DIR)
        run(["git", *git_identity(state), "commit", "-q", "-m", message], cwd=GIT_DIR)
        run(["git", "branch", "-q", "-M", ROLL_BRANCH, branch], cwd=GIT_DIR)
    elif count == 0:
        run(["git", *git_identity(state), "commit", "-q", "--allow-empty", "-m", message],
            cwd=GIT_DIR)
    elif dirty:
        run(["git", *git_identity(state), "commit", "-q", "--amend", "-m", message],
            cwd=GIT_DIR)
    if not remote:
        return True, "local only: the store is the backend"
    head = _git(GIT_DIR, "rev-parse", "HEAD")
    tracking = _git(GIT_DIR, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}")
    if head and head == tracking:
        return True, ""
    push = run(["git", "push", "-q", "--force-with-lease", "-u", "origin", branch],
               cwd=GIT_DIR, check=False)
    if push.returncode != 0:
        return False, ("git: the push was refused — another machine published first, "
                       "so the next pass reconciles against that")
    return True, ""


def git_tag(name: str, message: str = "", commit: str | None = None) -> None:
    """Tag HEAD, or an explicit commit — a rename must not move the point."""
    args = ["git", *git_identity({}), "tag", "-f", "-a", name]
    if commit:
        args.append(commit)
    args += ["-m", message or name]
    run(args, cwd=GIT_DIR)


def valid_snapshot_name(name: str) -> str | None:
    """Why this name cannot be a tag, or None if it can."""
    if not name or name != name.strip():
        return "a snapshot name cannot be empty or have surrounding spaces"
    if len(name) > 100:
        return "a snapshot name cannot be longer than 100 characters"
    bad = set(" ~^:?*[\\")
    if any(ch in bad or ord(ch) < 32 for ch in name):
        return "a snapshot name cannot contain spaces or any of ~ ^ : ? * [ \\"
    if name.startswith("-") or name.startswith(".") or name.endswith("."):
        return "a snapshot name cannot start with - or . and cannot end with ."
    if ".." in name or "@{" in name or name.endswith(".lock"):
        return "a snapshot name cannot contain .. or @{ or end with .lock"
    if run(["git", "check-ref-format", f"refs/tags/{name}"], cwd=GIT_DIR,
           check=False).returncode != 0:
        return f"{name!r} is not a valid tag name"
    return None


def snapshot_points(state) -> list[dict]:
    """Every resumable point: the rolling commit first, then the tags.

    Automatic tags (the ones a resume makes for itself) are marked, so the picker
    can show what the user named and nothing else.
    """
    points: list[dict] = []
    branch = state["git"]["branch"]
    tip = (_git(GIT_DIR, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}")
           or _git(GIT_DIR, "rev-parse", "--verify", "-q", "HEAD"))
    if tip:
        when = _git(GIT_DIR, "log", "-1", "--format=%cI", tip)
        points.append({"name": "latest", "label": "Latest", "when": when,
                       "auto": False, "latest": True})
    out = _git(GIT_DIR, "for-each-ref", "--sort=-creatordate",
               "--format=%(refname:short)\t%(creatordate:iso-strict)", "refs/tags")
    for line in out.splitlines():
        if "\t" not in line:
            continue
        name, when = line.split("\t", 1)
        points.append({"name": name, "label": name, "when": when,
                       "auto": name.startswith(RESUME_TAG_PREFIX), "latest": False})
    return points


def snapshot_create(state, name: str, quiet: bool = False) -> str:
    """Tag the state the store holds now, and publish the tag."""
    problem = valid_snapshot_name(name)
    if problem:
        raise RuntimeError(problem)
    if _git(GIT_DIR, "rev-parse", "--verify", "-q", f"refs/tags/{name}"):
        raise RuntimeError(f"a snapshot called {name!r} already exists — "
                           "rename it, or pick another name")
    note = git_fetch_reset(state)
    if note:
        print(f"git: {note}")
    published, push_note = git_roll(state, roll_message(state, subject=f"configsync snapshot {name}"))
    if push_note:
        print(f"git: {push_note}")
    git_tag(name, f"configsync snapshot {name} · {time.strftime('%Y-%m-%d %H:%M')}")
    pushed = run(["git", "push", "-q", "--force", "origin", f"refs/tags/{name}"],
                 cwd=GIT_DIR, check=False).returncode == 0
    if not quiet:
        print(f"snapshot: {name} — {'published' if pushed else 'kept locally, the push failed'}")
    return name


def snapshot_rename(state, old: str, new: str) -> None:
    problem = valid_snapshot_name(new)
    if problem:
        raise RuntimeError(problem)
    if not _git(GIT_DIR, "rev-parse", "--verify", "-q", f"refs/tags/{old}"):
        raise RuntimeError(f"no snapshot called {old!r}")
    if _git(GIT_DIR, "rev-parse", "--verify", "-q", f"refs/tags/{new}"):
        raise RuntimeError(f"a snapshot called {new!r} already exists")
    commit = _git(GIT_DIR, "rev-list", "-n", "1", old)
    git_tag(new, f"configsync snapshot {new} · {time.strftime('%Y-%m-%d %H:%M')}", commit)
    run(["git", "tag", "-d", old], cwd=GIT_DIR)
    if _git(GIT_DIR, "remote", "get-url", "origin"):
        run(["git", "push", "-q", "--force", "origin", f"refs/tags/{new}"],
            cwd=GIT_DIR, check=False)
        run(["git", "push", "-q", "origin", f":refs/tags/{old}"], cwd=GIT_DIR, check=False)
    print(f"snapshot: {old} is now {new} ({commit[:12]})")


def snapshot_drop(state, name: str) -> None:
    if not _git(GIT_DIR, "rev-parse", "--verify", "-q", f"refs/tags/{name}"):
        raise RuntimeError(f"no snapshot called {name!r}")
    run(["git", "tag", "-d", name], cwd=GIT_DIR)
    if _git(GIT_DIR, "remote", "get-url", "origin"):
        run(["git", "push", "-q", "origin", f":refs/tags/{name}"], cwd=GIT_DIR, check=False)
    print(f"snapshot: dropped {name}")


def snapshot_resolve(state, name: str) -> tuple[str, str]:
    """The commit a resume should go back to, and the label to report."""
    branch = state["git"]["branch"]
    if name in ("latest", ""):
        tip = (_git(GIT_DIR, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{branch}")
               or _git(GIT_DIR, "rev-parse", "--verify", "-q", "HEAD"))
        if not tip:
            raise RuntimeError("there is nothing to go back to yet")
        return tip, "Latest"
    commit = _git(GIT_DIR, "rev-parse", "--verify", "-q", f"refs/tags/{name}^{{commit}}")
    if not commit:
        raise RuntimeError(f"no snapshot called {name!r}")
    return commit, name


def _snapshot_tree(commit: str) -> Path:
    """Extract a snapshot's tree into a temp dir, for an honest dry-run plan.

    A resume dry-run must compare against the snapshot it would check out, not
    against whatever the store happens to hold now. Extracting to a scratch
    directory gives that without touching the store or the index.
    """
    # The store's own root is the repo; the tree that mirrors $HOME is its
    # `home/` subtree, so archive that and the relative paths line up.
    data = None
    for source in (f"{commit}:home", commit):
        proc = subprocess.run(["git", "archive", source], cwd=GIT_DIR,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              check=False)
        if proc.returncode == 0:
            data = proc.stdout
            break
    if data is None:
        raise RuntimeError("could not read the snapshot's tree")
    tree = Path(tempfile.mkdtemp(prefix="configsync-snapshot-"))
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:") as archive:
        try:
            archive.extractall(tree, filter="data")
        except TypeError:  # Python < 3.12 has no extraction filter
            archive.extractall(tree)
    return tree


def snapshot_resume(state, name: str, dry: bool = False) -> Report:
    """Put this machine back to a snapshot: local only, then published.

    The current state is tagged first (`pre-resume-…`), so the point being left
    is a named, pushed point rather than a reflog entry. The store is then set to
    the snapshot's tree and an ordinary pass runs in "the snapshot wins" mode:
    differing local files are moved to the trash and replaced, local-only files
    are moved to the trash, and everything the snapshot has is written back.
    """
    commit, label = snapshot_resolve(state, name)
    stamp_now = stamp()
    auto = f"{RESUME_TAG_PREFIX}{slug(name or 'latest')}-{stamp_now}"
    report = Report()
    if dry:
        print(f"resume: would go back to {label} ({commit[:12]})")
        tree = _snapshot_tree(commit)
        try:
            return sync_all(state, dry=True, force="backend", only="git",
                            git_root=tree)
        finally:
            shutil.rmtree(tree, ignore_errors=True)
    with OperationLock():
        note = git_fetch_reset(state)
        if note:
            report.notes.append(f"git: {note}")
        # What is being left behind, kept as a named point before anything moves.
        git_roll(state, roll_message(state, subject=f"configsync before resume to {label}"))
        git_tag(auto, f"configsync automatic: before resuming {label} · "
                      f"{time.strftime('%Y-%m-%d %H:%M')}")
        if _git(GIT_DIR, "remote", "get-url", "origin"):
            run(["git", "push", "-q", "--force", "origin", f"refs/tags/{auto}"],
                cwd=GIT_DIR, check=False)
        report.notes.append(f"kept {auto} as the state before this resume")
        run(["git", "checkout", "-q", "-B", state["git"]["branch"], commit], cwd=GIT_DIR)
        run(["git", "clean", "-qfd"], cwd=GIT_DIR)
        inner = sync_all(state, force="backend", only="git",
                         message=f"configsync resume {label}")
        report.absorb(label, PairResult())          # keep the counts below
        report.pushed, report.pulled = inner.pushed, inner.pulled
        report.deleted, report.kept = inner.deleted, inner.kept
        report.conflicts, report.errors = inner.conflicts, inner.errors
        report.notes += inner.notes
    return report


def app_patterns(app, cid: str | None = None) -> list[str]:
    """The rsync/scan filters for one app: always-on, generated, then its own."""
    patterns = (list(EXCLUDES) + list(ALWAYS_EXCLUDED)
                + list(VOLATILE.get(cid or "", [])))
    return patterns + list(app.get("exclude", []) or [])


def app_pairs(state, selected=None, include_disabled=False,
              git_root: Path | None = None) -> list[dict]:
    """One entry per enabled path: where it lives locally and in the backend.

    include_disabled adds the switched-off items, which the watcher needs: a
    watcher left over from an item that was just switched off is stale, and it
    can only be recognised as ours by its path.

    git_root points the git pairs at a different tree than the live store. A
    resume dry-run uses it to plan against the snapshot it would check out,
    without touching the real store.
    """
    pairs: list[dict] = []
    drive_raw = state["gdrive"].get("remote", "").strip()
    for cid, app in state["apps"].items():
        if app["target"] not in ("git", "gdrive"):
            continue
        if not app.get("enabled") and not include_disabled:
            continue
        if selected and cid not in selected:
            continue
        for raw in app["paths"]:
            original = expand(raw)
            try:
                rel = home_rel(original)
            except ValueError:
                continue  # a hand-edited state path outside $HOME
            if app["target"] == "gdrive":
                if not drive_raw:
                    continue
                backend = expand(drive_raw) / rel
            else:
                backend = (git_root or STORE) / rel
            pairs.append({
                "key": f"{app['target']}:{cid}:{rel}",
                "cid": cid,
                "app": app,
                "local": local_root(original),
                "backend": backend,
                # The name a single-file pair travels under (a resolved
                # symlink can change the name on disk).
                "name": Path(rel).name,
            })
    return pairs


class Report:
    """The result of one pass, in the shape the panel and lastSync use."""

    def __init__(self):
        self.pushed = self.pulled = self.deleted = self.kept = 0
        self.conflicts: list[str] = []
        self.notes: list[str] = []
        self.errors: list[str] = []
        # Per-backend breakdown, so the panel can show Git and Drive apart.
        self.git = None       # a Report for target == "git"
        self.drive = None     # a Report for target == "gdrive"
        self.published = None  # did the git push land? None when no git pairs

    def absorb(self, label: str, res: PairResult) -> None:
        self.pushed += res.pushed
        self.pulled += res.pulled
        self.deleted += res.deleted
        self.kept += res.kept
        self.conflicts += [f"{label}: {rel}" for rel in res.conflicts]
        self.notes += res.notes
        self.errors += res.errors

    def ok(self) -> bool:
        return not self.errors

    def message(self) -> str:
        if self.errors:
            return "⚠ " + self.errors[0]
        if not self.pushed and not self.pulled and not self.deleted:
            base = "up to date"
        else:
            parts = []
            if self.pushed:
                parts.append(f"{self.pushed} sent")
            if self.pulled:
                parts.append(f"{self.pulled} received")
            if self.deleted:
                parts.append(f"{self.deleted} removed")
            base = ", ".join(parts)
        if self.conflicts:
            base += f" · {len(self.conflicts)} conflict copy(ies)"
        if self.kept:
            base += f" · {self.kept} deletion(s) not propagated"
        return base


def sync_all(state, selected=None, dry=False, prefer=None, only=None,
             force=None, message=None, git_root: Path | None = None) -> Report:
    """One pass. `force="backend"` is a resume: the store is already the truth."""
    report = Report()
    report.git = Report()
    report.drive = Report()
    pairs = app_pairs(state, selected, git_root=git_root)
    if not dry:
        try:
            capture_software()
        except Exception as exc:  # noqa: BLE001
            report.notes.append(f"software capture skipped: {exc}")
    has_git = any(p["app"]["target"] == "git" for p in pairs)
    wants_git = has_git and (not only or only == "git")
    if wants_git and not force:
        # A resume has already put the store exactly where it should be, so it
        # does not fetch over itself.
        try:
            ensure_git_repo(state)
            if not dry:
                note = git_fetch_reset(state)
                if note:
                    report.notes.append(f"git: {note}")
        except Exception as exc:  # noqa: BLE001
            report.errors.append(str(exc).splitlines()[0])

    pending: list[tuple[str, dict, dict]] = []
    for pair in pairs:
        app = pair["app"]
        if only and app["target"] != only:
            continue
        if app["target"] == "gdrive" and not state["gdrive"].get("remote", "").strip():
            continue
        is_git = app["target"] == "git"
        delete = True if is_git else bool(state["gdrive"].get("delete", False))
        try:
            res = reconcile_pair(pair["key"], app["name"], pair["local"],
                                 pair["backend"],
                                 app_patterns(app, pair["cid"]), delete=delete, dry=dry,
                                 prefer=prefer, force=force,
                                 allow_secrets=bool(app.get("allowSecrets")),
                                 remote_slack=backend_tolerance(app),
                                 single_name=pair["name"],
                                 defer_baseline=is_git)
            report.absorb(app["name"], res)
            (report.git if is_git else report.drive).absorb(app["name"], res)
            if res.pending_baseline:
                pending.append(res.pending_baseline)
        except Exception as exc:  # noqa: BLE001 — report, never crash the shell
            line = f"{app['name']}: {str(exc).splitlines()[0]}"
            report.errors.append(line)
            (report.git if is_git else report.drive).errors.append(line)

    if not dry and wants_git:
        published, note = ((False, "") if not report.ok()
                           else git_roll(state, message or roll_message(state, report)))
        report.published = published
        if note:
            report.notes.append(f"git: {note}")
        for key, new_local, new_remote in pending:
            save_baseline(key, new_local, new_remote, published=published)
        if pending and not published:
            report.notes.append(
                "git: not published yet — the next pass keeps both versions rather "
                "than letting the remote overwrite local work")
    return report


# --- rsync watchers (Omarchy's rsw / lsw / dsw) ----------------------------
#
# Omarchy already ships the watcher: `rsw <source> <destination>` starts a
# detached inotifywait + `rsync -a` loop, `lsw` lists the running ones and `dsw`
# stops them (omarchy.org/manual/shell-functions). Starting one in the same shape
# instead of running a daemon of our own means our watchers show up in `lsw`,
# `dsw` stops them like any other, and anyone who knows `rsw` already knows what
# this does.
#
# The one difference is the `rsync` line: rsw takes two arguments and no flags,
# so its copy has no exclusions and would carry caches, logs, `node_modules` and
# secret files into the backend. Ours passes the same --exclude patterns the scan
# uses (`fresh_loop`). Everything else — the marker, the events, the one-way
# copy — is the same.
#
# The watcher only ever goes one way, local to backend, with no `--delete`: it
# can copy a change but it can never remove anything, on either side. Deletions
# and everything made on the other machine wait for the three-way pass
# (`watch --once`), which is what the systemd timer runs on its interval.

ROLL_BRANCH = "configsync-roll"     # scratch branch while flattening to one commit
RESUME_TAG_PREFIX = "pre-resume-"   # automatic tags a resume makes for itself

RSW_MARKER = "rsw-watch"          # rsw's own marker: how lsw and dsw find them
RSW_EVENTS = "modify,create,delete,move"


def fresh_loop(filters) -> str:
    """rsw's loop, with the plugin's exclusion rules added to its rsync.

    Omarchy's `rsw` is `rsync -a` and nothing else: two arguments, no way to pass
    `--exclude`. A verbatim copy would therefore carry caches, logs and secret
    files into the backend, which is what the rest of this tool refuses to do.
    Same process shape, same marker, same events — so `lsw` still lists it and
    `dsw` still stops it — with `--exclude` arguments the scan agrees with.
    """
    args = " ".join(f"--exclude {shlex.quote(pattern)}" for pattern in filters)
    args = (args + " ") if args else ""
    copy = f'rsync -a {args}"$1/" "$2"'
    return f'{copy}; while inotifywait -r -q -e {RSW_EVENTS} "$1"; do {copy}; done'


def rsync_ssh() -> str:
    """The shared SSH connection rsw reuses, so 1Password prompts once."""
    sockets = Path(os.environ.get("XDG_RUNTIME_DIR") or str(HOME / ".ssh/sockets"))
    try:
        sockets.mkdir(parents=True, exist_ok=True)
    except OSError:
        sockets = Path("/tmp")
    return (f"ssh -o ControlMaster=auto -o ControlPath={sockets}/rsw-%r@%h:%p "
            "-o ControlPersist=yes")


def rsw_watchers() -> list[dict]:
    """Every active watcher on the machine, parsed the way `lsw` parses them."""
    watchers = []
    out = run(["pgrep", "-af", RSW_MARKER + " "], check=False).stdout
    for line in out.splitlines():
        pid, _, cmd = line.strip().partition(" ")
        if not pid.isdigit():
            continue
        rest = cmd.split(RSW_MARKER + " ", 1)[-1]
        source, _, destination = rest.rpartition(" ")
        watchers.append({"pid": int(pid), "source": source,
                         "destination": destination, "command": cmd})
    return watchers


def managed_sources(state, enabled_only=True) -> dict[str, str]:
    """{local path: backend path} for the pairs this plugin owns."""
    targets: dict[str, str] = {}
    pairs = (app_pairs(state) if enabled_only
             else app_pairs(state, include_disabled=True))
    for pair in pairs:
        local_base, backend_base, _is_dir = pair_bases(pair["local"], pair["backend"])
        targets[str(local_base)] = str(backend_base)
    return targets


def watch_targets(state) -> dict[str, tuple[str, list[str]]]:
    """{local path: (backend path, rsync filters)} for every enabled pair.

    The filters are the ones the scan uses, minus the secret-file list for an
    item that has been allowed to carry secrets.
    """
    targets: dict[str, tuple[str, list[str]]] = {}
    for pair in app_pairs(state):
        local_base, backend_base, is_dir = pair_bases(pair["local"], pair["backend"])
        if not is_dir:
            # A single file's "base" is its parent directory. Watching that for
            # ~/.bashrc would watch all of $HOME and, because the backend store
            # lives under $HOME, copy the store into itself. Files change rarely;
            # the periodic pass handles them.
            continue
        if pair["app"]["target"] == "git":
            # A fast copy into the git store cannot reach the other machine
            # before a pass commits and pushes it, so it buys no latency — and it
            # leaves the store's working tree holding local content, which the
            # next pass reads as a change made on the other machine. That is what
            # used to manufacture a conflict copy on every pass for any file its
            # owner rewrites.
            continue
        filters = app_patterns(pair["app"], pair["cid"])
        if not pair["app"].get("allowSecrets"):
            filters = filters + list(SECRET_FILES)
        targets[str(local_base)] = (str(backend_base), filters)
    return targets


def is_ours(watcher: dict, sources: dict[str, str]) -> bool:
    """Is this watcher ours? Asked of the command line, which survives spaces."""
    return any(f" {source} {destination}" in watcher["command"]
               for source, destination in sources.items())


def start_rsw(source: Path, destination: Path, filters=()) -> str:
    """Start one watcher. Returns "" on success, or why it did not start."""
    # A copy whose destination is inside its source would recurse: the watcher
    # would rsync the store into itself, once per change, until the disk fills.
    # Never start one; the periodic pass is what should handle such a pair.
    try:
        src = Path(source).resolve()
        dst = Path(destination).resolve()
    except OSError:
        src, dst = Path(source), Path(destination)
    if src == dst or dst.is_relative_to(src) or src.is_relative_to(dst):
        return (f"refusing to watch {to_tilde(src)}: its backend "
                f"{to_tilde(dst)} overlaps it")
    for binary, package in (("inotifywait", "inotify-tools"), ("rsync", "rsync")):
        if not have(binary):
            return f"{binary} is not installed (sudo pacman -S {package})"
    # rsw runs a plain `rsync -a`, without --mkpath, so the destination's parent
    # has to exist before it starts or its very first copy fails.
    try:
        destination.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        return f"cannot create {to_tilde(destination.parent)}: {exc}"
    env = dict(os.environ, RSYNC_RSH=rsync_ssh())
    # Exactly how rsw starts one: detached, marked `rsw-watch`, same events.
    argv = ["setsid", "--fork", "env", f"RSYNC_RSH={env['RSYNC_RSH']}",
            "bash", "-c", fresh_loop(filters), RSW_MARKER,
            str(source), str(destination)]
    try:
        subprocess.run(argv, env=env, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=20, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        return f"could not start the watcher for {to_tilde(source)}: {exc}"
    # rsw detaches, so ask the process table whether it is really there.
    deadline = time.time() + 5
    while time.time() < deadline:
        for watcher in rsw_watchers():
            if (watcher["source"] == str(source)
                    and watcher["destination"] == str(destination)):
                return ""
        time.sleep(0.2)
    return f"the watcher for {to_tilde(source)} did not start"


def stop_rsw(pid: int) -> bool:
    """Stop one watcher the way `dsw` does: signal its whole process group."""
    return run(["kill", "--", f"-{pid}"], check=False).returncode == 0


def watch_ensure(state, quiet=False) -> list[str]:
    """Make the running watchers match the state, and say what changed."""
    pairs = app_pairs(state) if state["watch"].get("enabled") else []
    wanted = watch_targets(state) if pairs else {}
    if any(pair["app"]["target"] == "git" for pair in pairs):
        # A git pair's destination is the store, which has to be a repository
        # before files are copied into it.
        try:
            ensure_git_repo(state)
        except Exception as exc:  # noqa: BLE001 — the watcher can still start
            if not quiet:
                print(f"store: {str(exc).splitlines()[0]}")
    live = rsw_watchers()
    notes: list[str] = []
    for source, (destination, filters) in sorted(wanted.items()):
        if any(w["source"] == source and w["destination"] == destination
               for w in live):
            continue
        problem = start_rsw(Path(source), Path(destination), filters)
        notes.append(problem or
                     f"watching {to_tilde(Path(source))} -> "
                     f"{to_tilde(Path(destination))}")
    # A watcher of ours pointing somewhere it should not any more: the item was
    # switched off, or its backend moved. Everyone else's watchers are left alone.
    known = managed_sources(state, enabled_only=False)
    for watcher in live:
        source, destination = watcher["source"], watcher["destination"]
        if source in wanted and wanted[source][0] == destination:
            continue
        if source in known and stop_rsw(watcher["pid"]):
            notes.append(f"stopped the stale watcher for {to_tilde(Path(source))}")
    if not quiet and not notes:
        notes.append("every enabled path is already being watched")
    return notes


def watch_stop(state, everything=False) -> list[str]:
    """Stop this plugin's watchers, or (with everything) every one, like dsw."""
    ours = managed_sources(state, enabled_only=False)
    notes = []
    for watcher in rsw_watchers():
        if not everything and not is_ours(watcher, ours):
            continue
        if stop_rsw(watcher["pid"]):
            notes.append(f"stopped the watcher for {to_tilde(Path(watcher['source']))}")
    return notes or ["no watchers were running"]


def watch_view(state) -> dict:
    """The live picture the panel and `configsync watch` show."""
    ours = managed_sources(state, enabled_only=False)
    watchers = []
    for watcher in rsw_watchers():
        watchers.append({
            "pid": watcher["pid"],
            "source": to_tilde(Path(watcher["source"])),
            "destination": to_tilde(Path(watcher["destination"])),
            "mine": is_ours(watcher, ours),
        })
    return {
        "enabled": bool(state["watch"].get("enabled")),
        "pullMinutes": int(state["watch"].get("pullMinutes", 10)),
        "watchers": watchers,
        "watching": sum(1 for w in watchers if w["mine"]),
        "others": sum(1 for w in watchers if not w["mine"]),
        "expected": len(watch_targets(state)),
        "lastPass": state["watch"].get("lastPass", ""),
        "lastResult": state["watch"].get("lastResult", ""),
        "systemd": bool(state["watch"].get("systemd")),
        "systemdAvailable": systemd_available(),
        "service": service_status(),
        "mode": "rsw" if watchers else "",
    }


# --- the periodic pass (a systemd user timer) ------------------------------
#
# The watchers cover "I just changed something here". Nothing covers "the other
# machine changed something" — inotify cannot see that — so a timer runs one full
# three-way pass on the interval, at login, and a minute after the switch is
# turned on. Where there is no systemd user session the shell service runs the
# same pass on a Qt timer instead.

_systemd_cache: bool | None = None


def systemd_available() -> bool:
    global _systemd_cache
    if _systemd_cache is not None:
        return _systemd_cache
    ok = False
    if have("systemctl") and os.environ.get("XDG_RUNTIME_DIR"):
        proc = run(["systemctl", "--user", "show", "--property=Version"],
                   check=False, timeout=5)
        ok = proc.returncode == 0
    _systemd_cache = ok
    return ok


def service_unit_text(script: Path) -> str:
    quoted = str(script).replace("\\", "\\\\").replace('"', '\\"')
    return f"""[Unit]
Description=Config Sync: reconcile configs and folders in both directions
Documentation=https://github.com/iamkuo/omarchy-configsync-plugin
After=default.target

[Service]
Type=oneshot
# The rsw watchers do the fast local -> backend copies; this unit makes sure they
# are alive and then does the slow pass (pulls, deletions, git commits).
ExecStartPre="{sys.executable}" "{quoted}" watch --ensure
ExecStart="{sys.executable}" "{quoted}" watch --once
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=900
"""


def timer_unit_text(minutes: int) -> str:
    return f"""[Unit]
Description=Config Sync: periodic full pass
Documentation=https://github.com/iamkuo/omarchy-configsync-plugin

[Timer]
OnBootSec=45s
OnActiveSec=60s
OnUnitInactiveSec={max(1, int(minutes))}m
AccuracySec=30s

[Install]
WantedBy=timers.target
"""


def service_status() -> dict:
    unit = UNIT_DIR / UNIT_NAME
    timer = UNIT_DIR / TIMER_NAME
    active = enabled = False
    if timer.exists() and have("systemctl") and systemd_available():
        active = run(["systemctl", "--user", "is-active", TIMER_NAME],
                     check=False, timeout=5).stdout.strip() == "active"
        enabled = run(["systemctl", "--user", "is-enabled", TIMER_NAME],
                      check=False, timeout=5).stdout.strip() == "enabled"
    return {"installed": unit.exists(), "timerInstalled": timer.exists(),
            "active": active, "enabled": enabled, "path": to_tilde(timer)}


def _set_watch_systemd(value: bool) -> None:
    """Record whether systemd owns the periodic pass.

    The shell service reads this from the state file; without it written, the
    service cannot tell that a systemd timer exists and runs a second schedule
    of its own. Re-read before writing so a concurrent toggle is not clobbered.
    """
    fresh = load_state()
    watch = fresh.setdefault("watch", {})
    if bool(watch.get("systemd")) == bool(value):
        return
    watch["systemd"] = bool(value)
    save_state(fresh)


def service_install(pull_minutes=None, verbose=True) -> tuple[bool, str]:
    """Write and start the user timer. Returns (installed, message)."""
    if not systemd_available():
        return False, "no systemd user session — the shell service runs the passes instead"
    state = load_state()
    minutes = max(1, int(pull_minutes or state["watch"].get("pullMinutes", 10)))
    script = Path(__file__).resolve()
    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    wanted = {UNIT_DIR / UNIT_NAME: service_unit_text(script),
              UNIT_DIR / TIMER_NAME: timer_unit_text(minutes)}
    if any(not path.exists() or path.read_text() != text
           for path, text in wanted.items()):
        for path, text in wanted.items():
            path.write_text(text)
        run(["systemctl", "--user", "daemon-reload"], check=False, timeout=30)
    proc = run(["systemctl", "--user", "enable", "--now", TIMER_NAME],
               check=False, timeout=30)
    if proc.returncode != 0:
        return False, f"systemctl --user enable failed: {proc.stdout.strip()}"
    _set_watch_systemd(True)
    if verbose:
        print(f"passes: systemd user timer {to_tilde(UNIT_DIR / TIMER_NAME)} "
              f"every {minutes} min")
    return True, "systemd"


def service_enable(enabled: bool, verbose=False) -> tuple[bool, str]:
    """Turn the periodic pass on or off without removing the units."""
    if not systemd_available():
        return False, "the shell service runs the passes"
    if enabled:
        return service_install(verbose=verbose)
    proc = run(["systemctl", "--user", "disable", "--now", TIMER_NAME],
               check=False, timeout=30)
    if proc.returncode == 0:
        _set_watch_systemd(False)
    if verbose:
        print("passes: timer disabled")
    return proc.returncode == 0, "systemd"


def service_uninstall(verbose=True) -> None:
    for name in (TIMER_NAME, UNIT_NAME):
        if have("systemctl") and systemd_available():
            run(["systemctl", "--user", "disable", "--now", name],
                check=False, timeout=30)
    removed = False
    for path in (UNIT_DIR / TIMER_NAME, UNIT_DIR / UNIT_NAME):
        if path.exists():
            path.unlink()
            removed = True
    if removed and have("systemctl") and systemd_available():
        run(["systemctl", "--user", "daemon-reload"], check=False, timeout=30)
    _set_watch_systemd(False)
    if verbose:
        print("passes: systemd units removed")


def run_pass(force=False) -> tuple[bool, str]:
    """One full three-way pass, the way the timer runs it."""
    state = load_state()
    if not state["watch"].get("enabled") and not force:
        return False, "watch is off — turn it on with `configsync watch --on`"
    report = Report()
    try:
        with OperationLock():
            report = sync_all(state)
            record_result(state, report.ok(), report.message(), report,
                          watch_pass=True)
            return report.ok(), report.message()
    except RuntimeError as exc:
        return False, str(exc)
    except Exception as exc:  # noqa: BLE001 — never crash the user's shell
        return False, str(exc).splitlines()[0]


# --- commands --------------------------------------------------------------

def record_result(state, ok, message, report: Report | None = None,
                  watch_pass: bool = False) -> None:
    # Re-read the file before writing: a long pass must not clobber a toggle
    # the user flipped in the panel meanwhile. Only the last-sync result is
    # ours to write.
    fresh = load_state()
    fresh["lastSync"] = {
        "at": time.strftime("%Y-%m-%d %H:%M"),
        "ok": ok,
        "message": message,
    }
    if report is not None:
        fresh["lastSync"].update({
            "pushed": report.pushed,
            "pulled": report.pulled,
            "deleted": report.deleted,
            "conflicts": len(report.conflicts),
            "conflictPaths": report.conflicts[:5],
            "notes": report.notes[-5:],
        })
        for name, sub in (("git", report.git), ("drive", report.drive)):
            if sub is None:
                continue
            entry = {
                "at": fresh["lastSync"]["at"],
                "ok": not sub.errors,
                "pushed": sub.pushed,
                "pulled": sub.pulled,
                "deleted": sub.deleted,
                "conflicts": len(sub.conflicts),
            }
            if name == "git" and report.published is not None:
                entry["published"] = bool(report.published)
            fresh["lastSync"][name] = entry
    if watch_pass:
        fresh["watch"]["lastPass"] = fresh["lastSync"]["at"]
        fresh["watch"]["lastResult"] = message
    save_state(fresh)


def cmd_scan(args):
    with OperationLock():
        state = load_state()
        added = merge_detected(state)
        save_state(state)
        print(f"detected {len(state['apps'])} apps ({added} new/changed)")


def git_divergence(state) -> tuple[int, int, str]:
    """(ahead, behind, last commit time) of the store vs its last fetch.

    This is deliberately fetch-free: the panel reads `state` often, and a status
    read must never wait on the network. It reflects the last time a pass
    fetched, which is exactly what the next pass will reconcile against.
    """
    branch = state["git"]["branch"]
    if not (GIT_DIR / ".git").exists():
        return 0, 0, ""
    if not _git(GIT_DIR, "rev-parse", "--verify", "-q",
                f"refs/remotes/origin/{branch}"):
        return 0, 0, _git(GIT_DIR, "log", "-1", "--format=%cI", "HEAD")
    counts = _git(GIT_DIR, "rev-list", "--left-right", "--count",
                  f"origin/{branch}...HEAD").split()
    behind = ahead = 0
    if len(counts) == 2:
        behind, ahead = int(counts[0]), int(counts[1])
    return ahead, behind, _git(GIT_DIR, "log", "-1", "--format=%cI", "HEAD")


def cmd_state(args):
    state = load_state()
    apps = [dict(id=cid, **app) for cid, app in state["apps"].items()]
    apps.sort(key=lambda a: a["name"].lower())
    gdrive_remote = state["gdrive"].get("remote", "").strip()
    trash_count = 0
    if (TRASH_DIR / "index.json").exists():
        try:
            trash_count = len(json.loads((TRASH_DIR / "index.json").read_text()))
        except (OSError, json.JSONDecodeError):
            trash_count = 0
    git_ahead, git_behind, git_last = git_divergence(state)
    out = {
        "version": state["version"],
        # For the panel: it shortens paths against this instead of guessing.
        "home": str(HOME),
        "git": {
            "remote": state["git"].get("remote", ""),
            "branch": state["git"].get("branch", "main"),
            "configured": bool(state["git"].get("remote", "").strip()),
            "ahead": git_ahead,
            "behind": git_behind,
            "lastLog": git_last,
        },
        "gdrive": {
            "remote": state["gdrive"].get("remote", ""),
            "configured": bool(gdrive_remote),
            "available": bool(gdrive_remote) and expand(gdrive_remote).exists(),
            "delete": bool(state["gdrive"].get("delete", False)),
        },
        "watch": watch_view(state),
        "lastSync": state["lastSync"],
        "trash": trash_count,
        "software": software_summary(),
        "apps": apps,
    }
    print(json.dumps(out, indent=2))


def _app(state, cid):
    if cid not in state["apps"]:
        sys.exit(f"unknown app: {cid}")
    return state["apps"][cid]


def cmd_set_enabled(args):
    state = load_state()
    _app(state, args.id)["enabled"] = args.value == "true"
    save_state(state)
    print("ok")


def cmd_set_target(args):
    if args.value not in ("git", "gdrive", "none"):
        sys.exit("target must be git, gdrive or none")
    state = load_state()
    _app(state, args.id)["target"] = args.value
    save_state(state)
    print("ok")


def cmd_set_secrets(args):
    state = load_state()
    _app(state, args.id)["allowSecrets"] = args.value == "true"
    save_state(state)
    print("ok — key and token files in this item are copied as-is"
          if args.value == "true" else "ok — key and token files are skipped again")


def cmd_set_backend(args):
    state = load_state()
    if args.backend == "git":
        if args.key == "remote":
            state["git"]["remote"] = args.value
        elif args.key == "branch":
            state["git"]["branch"] = args.value or "main"
        else:
            sys.exit("git accepts remote or branch")
    elif args.backend == "gdrive":
        if args.key == "remote":
            state["gdrive"]["remote"] = args.value
        elif args.key == "delete":
            state["gdrive"]["delete"] = args.value == "true"
        else:
            sys.exit("gdrive accepts remote or delete")
    elif args.backend == "watch":
        if args.key == "enabled":
            # The same switch the panel flips: act on it, do not just record it.
            watch_args = argparse.Namespace(on=args.value == "true",
                                            off=args.value != "true", ensure=False,
                                            stop=False, all=False, once=False,
                                            force=False, status=False)
            if args.value == "true":
                state["watch"]["enabled"] = True
                save_state(state)
            return cmd_watch(watch_args)
        if args.key == "pull":
            state["watch"]["pullMinutes"] = max(1, int(args.value))
            save_state(state)
            if service_status()["timerInstalled"]:
                service_install(state["watch"]["pullMinutes"], verbose=False)
            print(f"ok — full pass every {state['watch']['pullMinutes']} min")
            return
        if args.key == "debounce":
            sys.exit("the debounce is gone: the watchers are Omarchy's own rsw "
                     "processes now (`configsync watch --status` lists them)")
        sys.exit("watch accepts enabled or pull")
    elif args.backend == "auto":
        # Kept so an older panel or script does not break; maps onto the watcher.
        if args.key == "enabled":
            watch_args = argparse.Namespace(on=args.value == "true",
                                            off=args.value != "true", ensure=False,
                                            stop=False, all=False, once=False,
                                            force=False, status=False)
            if args.value == "true":
                state["watch"]["enabled"] = True
                save_state(state)
            return cmd_watch(watch_args)
        elif args.key == "interval":
            state["watch"]["pullMinutes"] = max(1, int(args.value))
        else:
            sys.exit("auto accepts enabled or interval")
    else:
        sys.exit("unknown backend")
    save_state(state)
    print("ok")


def cmd_set_all(args):
    state = load_state()
    for app in state["apps"].values():
        app["enabled"] = args.value == "true"
    save_state(state)
    print("ok")


def cmd_sync(args):
    with OperationLock():
        state = load_state()
        selected = set(args.ids) if args.ids else None
        report = sync_all(state, selected, dry=args.dry_run, prefer=args.prefer,
                          only=args.only)
        if args.dry_run:
            print(report.message())
            return
        record_result(state, report.ok(), report.message(), report)
        print(report.message())
        for note in report.notes:
            print(f"  {note}")
        sys.exit(0 if report.ok() else 1)


def cmd_watch(args):
    state = load_state()
    if args.on or args.off:
        state["watch"]["enabled"] = bool(args.on)
        save_state(state)
        if args.off:
            for note in watch_stop(state):
                print(note)
            ok, message = service_enable(False)
            print("watch: off" + ("" if ok else f" ({message})"))
            return 0
    if args.stop:
        for note in watch_stop(state, everything=args.all):
            print(note)
        if args.all:
            return 0
    if args.ensure or args.on:
        for note in watch_ensure(state):
            print(note)
    if args.on:
        ok, message = service_enable(True)
        print("watch: on — " + (f"full pass every "
                                f"{state['watch'].get('pullMinutes', 10)} min"
                                if ok else message))
        return 0
    if args.once:
        ok, message = run_pass(force=args.force)
        print(message)
        return 0 if ok else 1
    if args.status:
        print(json.dumps(watch_view(state), indent=2))
        return 0
    # Bare `configsync watch`: the same picture `lsw` gives, plus the switch.
    view = watch_view(state)
    for watcher in view["watchers"]:
        tag = "" if watcher["mine"] else "  (started outside config sync)"
        print(f"{watcher['pid']}: {watcher['source']} -> {watcher['destination']}{tag}")
    if not view["watchers"]:
        print("No active watchers")
    print(f"watch: {'on' if view['enabled'] else 'off'} · "
          f"{view['watching']}/{view['expected']} path(s) watched · "
          f"full pass every {view['pullMinutes']} min")
    if view["enabled"] and view["watching"] < view["expected"]:
        print("some paths are not being watched — `configsync watch --ensure` "
              "starts them")
    print("rsw starts one, lsw lists them, dsw stops them all: "
          "`configsync watch --on|--off`, `--ensure`, `--stop [--all]`, `--once`")
    return 0


def cmd_service(args):
    if args.action == "install":
        state = load_state()
        ok, message = service_install(state["watch"].get("pullMinutes", 10))
        print(f"passes: {'timer installed' if ok else message}")
        return 0 if ok else 1
    if args.action == "uninstall":
        service_uninstall()
        return 0
    print(json.dumps(service_status(), indent=2))
    return 0


def cmd_snapshot(args):
    """Named points: the only history a squashed branch keeps."""
    action = args.action or "list"
    state = load_state()
    try:
        if action == "create":
            if not args.name:
                sys.exit("snapshot create needs a name")
            with OperationLock():
                ensure_git_repo(state)
                snapshot_create(state, args.name)
            return 0
        if action == "list":
            points = [p for p in snapshot_points(state) if args.all or not p["auto"]]
            if args.json:
                print(json.dumps(points, indent=2))
                return 0
            if not points:
                print("no snapshots yet — `configsync snapshot create <name>` keeps one")
                return 0
            for point in points:
                if point["latest"]:
                    print(f"latest   · {point['when']}  (the rolling commit)")
                else:
                    kind = "automatic" if point["auto"] else "snapshot"
                    print(f"{point['name']:<24} · {point['when']}  ({kind})")
            return 0
        if action == "rename":
            if not args.name or not args.new_name:
                sys.exit("snapshot rename needs the old and the new name")
            with OperationLock():
                snapshot_rename(state, args.name, args.new_name)
            return 0
        if action == "drop":
            if not args.name:
                sys.exit("snapshot drop needs a name")
            with OperationLock():
                snapshot_drop(state, args.name)
            return 0
        if action == "resume":
            name = args.name or "latest"
            if args.dry_run:
                report = snapshot_resume(state, name, dry=True)
                print(report.message())
                for note in report.notes:
                    print(f"  {note}")
                return 0
            if not args.yes:
                if not sys.stdin.isatty():
                    sys.exit("add --yes to confirm a resume: it overwrites local files "
                             "(their current versions move to the trash)")
                answer = input(f"Resume this machine to {name!r}? Files that differ are "
                               "overwritten and the versions being replaced move to the "
                               "trash. [y/N] ")
                if answer.strip().lower() not in ("y", "yes"):
                    sys.exit("resume: cancelled")
            report = snapshot_resume(state, name)
            print(report.message())
            for note in report.notes:
                print(f"  {note}")
            return 0 if report.ok() else 1
        sys.exit(f"unknown snapshot action: {action}")
    except RuntimeError as exc:
        sys.exit(str(exc))


def cmd_trash(args):
    index = TRASH_DIR / "index.json"
    entries = []
    if index.exists():
        try:
            entries = json.loads(index.read_text())
        except (OSError, json.JSONDecodeError):
            entries = []
    if args.action == "list":
        print(json.dumps(entries[-args.limit:], indent=2))
        return 0
    if args.action == "empty":
        shutil.rmtree(TRASH_DIR, ignore_errors=True)
        print(f"trash: emptied ({len(entries)} entr(ies) removed)")
        return 0
    wanted = entries if args.action == "restore-all" else entries[-1:]
    remaining = [] if args.action == "restore-all" else entries[:-1]
    restored = 0
    for entry in wanted:
        source = Path(entry.get("trashed", ""))
        if not source.exists():
            continue
        # Older entries only know the pair-relative path; fall back to it.
        target = Path(entry.get("path") or (HOME / entry.get("rel", "")))
        target.parent.mkdir(parents=True, exist_ok=True)
        try:
            if target.exists():
                # Never overwrite what is there now — keep both.
                target = target.with_name(conflict_name(target.name))
            shutil.move(str(source), str(target))
            restored += 1
        except (OSError, shutil.Error) as exc:
            print(f"trash: cannot restore {to_tilde(target)}: {exc}")
            remaining.append(entry)
    # Drop only the directories this call emptied; anything still trashed stays.
    for stamp_dir in sorted(TRASH_DIR.glob("*")):
        if stamp_dir.is_dir() and not any(stamp_dir.rglob("*")):
            shutil.rmtree(stamp_dir, ignore_errors=True)
    if remaining:
        index.write_text(json.dumps(remaining[-500:], indent=2) + "\n")
    elif index.exists():
        index.write_text("[]\n")
    print(f"trash: restored {restored} item(s) into {to_tilde(HOME)}")
    return 0


def cmd_conflicts(args):
    """List the local conflict copies, or retire the old ones.

    A conflict copy is kept beside the file that won, is never synced, and is
    never needed by the other machine. Nothing deletes them on its own — a run
    that keeps losing the same file (a daemon that rewrites it, a push that keeps
    being refused) would otherwise leave one per pass forever, so `prune` keeps
    the newest few and moves the rest to the trash.
    """
    state = load_state()
    action = args.action or "list"
    copies = local_conflict_copies(state)
    if action == "list":
        rows = [{"path": to_tilde(p), "size": p.stat().st_size,
                 "at": time.strftime("%Y-%m-%d %H:%M",
                                     time.localtime(p.stat().st_mtime)),
                 "original": to_tilde(original_of(p))}
                for p in copies]
        print(json.dumps(rows, indent=2))
        return 0

    keep = 0 if action == "empty" else max(0, args.keep)
    with OperationLock():
        try:
            ensure_git_repo(state)
            git_fetch_reset(state)
        except Exception as exc:  # noqa: BLE001
            print(f"conflicts: git: {str(exc).splitlines()[0]}", file=sys.stderr)
        retired = prune_conflict_copies(copies, keep)
        retired += prune_first_sync_dirs(keep)
        in_store = store_conflict_copies()
        for path in in_store:
            trash(path, str(path.relative_to(STORE)), "conflicts", "conflicts")
        if in_store:
            published, note = git_roll(
                state, roll_message(state, subject=f"configsync conflicts {action}"))
            if not published:
                print(f"conflicts: git: {note}", file=sys.stderr)
        total = retired + len(in_store)
        print(f"conflicts: {total} cop(ies) retired to the trash, "
              f"{keep} kept per file")
    return 0


def local_conflict_copies(state) -> list[Path]:
    """Every conflict copy sitting in a synced local tree."""
    found: list[Path] = []
    seen: set[str] = set()
    for pair in app_pairs(state, include_disabled=True):
        base, _, is_dir = pair_bases(pair["local"], pair["backend"])
        if not is_dir:
            found += conflict_copies_of(pair["local"].parent, pair["local"].name)
            continue
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames[:] = [d for d in dirnames if d not in ("node_modules", ".git")]
            for name in filenames:
                if ".conflict-" in name:
                    path = Path(dirpath) / name
                    if str(path) not in seen:
                        seen.add(str(path))
                        found.append(path)
    return sorted(found)


CONFLICT_RE = re.compile(
    r"^(?P<stem>.+?)\.conflict-(?P<rest>.*?)(?P<stamp>\d{8}-\d{6})(?P<suffix>\.[^.]*)?$")


def original_of(path: Path) -> Path:
    """The file a conflict copy was made from: same directory, original name.

    `name` carries the winner's stem, then `.conflict-<host>-<stamp>`, then the
    winner's suffix — so `config` gives `config.conflict-host-stamp` (no suffix)
    and `config.json` gives `config.conflict-host-stamp.json`. Only the stamp
    tells the two apart, hence the pattern rather than `Path.suffix`.
    """
    match = CONFLICT_RE.match(path.name)
    if not match:
        return path
    return path.with_name(match.group("stem") + (match.group("suffix") or ""))


def prune_conflict_copies(copies: list[Path], keep: int) -> int:
    """Keep the newest `keep` copies per original, trash the rest."""
    groups: dict[Path, list[Path]] = {}
    for path in copies:
        groups.setdefault(original_of(path), []).append(path)
    retired = 0
    for original, group in groups.items():
        group.sort(key=lambda p: p.stat().st_mtime, reverse=True)
        for path in group[keep:]:
            trash(path, to_tilde(path).removeprefix("~/"), "conflicts", "conflicts")
            retired += 1
    return retired


def prune_first_sync_dirs(keep: int) -> int:
    """First-sync copies are one-shot records; keep the newest `keep` batches."""
    batches = sorted((p for p in CONFLICTS_DIR.glob("first-sync-*") if p.is_dir()),
                     key=lambda p: p.stat().st_mtime, reverse=True)
    retired = 0
    for directory in batches[keep:]:
        retired += sum(1 for path in directory.rglob("*") if path.is_file()) or 1
        trash(directory, directory.name, "conflicts", "conflicts")
    return retired


def store_conflict_copies() -> list[Path]:
    """Conflict copies an older version already committed to the git store."""
    if not STORE.is_dir():
        return []
    found = []
    for dirpath, dirnames, filenames in os.walk(STORE):
        dirnames[:] = [d for d in dirnames if d != ".git"]
        for name in filenames:
            if ".conflict-" in name:
                found.append(Path(dirpath) / name)
    return sorted(found)


def cmd_download(args):
    """Fetch the git backend into the store without touching $HOME."""
    with OperationLock():
        state = load_state()
        try:
            ensure_git_repo(state)
            git_fetch_reset(state)
            record_result(state, True, "downloaded the git backend into the local store")
            print("downloaded the git backend into the local store")
        except Exception as exc:  # noqa: BLE001
            record_result(state, False, str(exc).splitlines()[0])
            print(f"error: {str(exc).splitlines()[0]}", file=sys.stderr)
            return 1
    return 0


def cmd_deploy(args):
    """Write the backend's copy into $HOME, backend wins (recovery tool)."""
    with OperationLock():
        state = load_state()
        report = sync_all(state, None, dry=args.dry_run, prefer="remote")
        if args.dry_run:
            print(report.message())
            return 0
        record_result(state, report.ok(), report.message(), report)
        print(report.message())
        return 0 if report.ok() else 1


def cmd_capture_software(args):
    with OperationLock():
        manifest = capture_software()
        print(f"captured {len(manifest['plugins'])} plugin(s) and "
              f"{len(manifest['packages']['native'])} + "
              f"{len(manifest['packages']['aur'])} package(s)")


def cmd_install_software(args):
    # Reading the plan is not a mutation: it must answer even while a pass holds
    # the operation lock, or the panel's "Show plan" is a no-op whenever it
    # matters (during a pass, which is exactly when the user is looking).
    if args.plan or (not args.yes and not sys.stdin.isatty()):
        print(json.dumps(software_plan(), indent=2))
        return 0
    with OperationLock():
        state = load_state()
        try:
            message = install_software(dry=args.dry_run)
            record_result(state, True, message)
            print(message)
        except Exception as exc:  # noqa: BLE001
            record_result(state, False, str(exc).splitlines()[0])
            print(f"error: {str(exc).splitlines()[0]}", file=sys.stderr)
            return 1
    return 0


def cmd_reset(args):
    with OperationLock():
        state = default_state()
        merge_detected(state)
        save_state(state)
        if args.purge:
            service_uninstall(verbose=False)
            shutil.rmtree(GIT_DIR, ignore_errors=True)
            shutil.rmtree(GDRIVE_STORE, ignore_errors=True)
            shutil.rmtree(BASELINE_DIR, ignore_errors=True)
            try:
                WATCH_STATUS.unlink()
            except OSError:
                pass
    if args.purge:
        print("reset and purged local stores "
              f"(trash and conflict copies left in {to_tilde(DATA_DIR)})")
    else:
        print("reset")


def cmd_add(args):
    with OperationLock():
        state = load_state()
        target = expand(args.path)
        if not target.exists():
            sys.exit(f"no such file or folder: {args.path}")
        if not target.is_relative_to(HOME):
            sys.exit("only paths inside your home directory can be synced")
        rel = home_rel(target)
        if is_secret(rel):
            sys.exit("refusing to sync a credentials path")
        real = local_root(target)
        for reserved, why in ((DATA_DIR, "the sync store"),
                              (GIT_DIR, "the git backend"),
                              (PLUGIN_DIR, "installed plugins")):
            if real == reserved or reserved.is_relative_to(real):
                sys.exit(f"refusing to sync {why} into itself")
        for other, app in state["apps"].items():
            # Two items holding the same path would fight over it every pass.
            for existing in app.get("paths", []):
                try:
                    if home_rel(expand(existing)) == rel:
                        sys.exit(f"already synced by {other} — "
                                 f"change that one instead of adding a second")
                except ValueError:
                    continue
        cid = args.id or ("custom-" + rel.strip("/").replace("/", "-"))
        note = "added by you"
        if target.is_symlink():
            note = f"added by you — symlinked to {real}"
        state["apps"][cid] = {
            "name": args.name or rel,
            "kind": "custom",
            "paths": [to_tilde(target)],
            "target": args.target,
            "enabled": True,
            "risky": False,
            "note": note,
        }
        save_state(state)
        print(f"added {cid}")


def cmd_remove(args):
    with OperationLock():
        state = load_state()
        if args.id not in state["apps"]:
            sys.exit(f"unknown app: {args.id}")
        # A hand-added path is deleted outright; a detected one is remembered
        # as hidden so the next scan does not put it straight back.
        if state["apps"][args.id].get("kind") != "custom":
            hidden = set(state.get("hidden", []))
            hidden.add(args.id)
            state["hidden"] = sorted(hidden)
        del state["apps"][args.id]
        save_state(state)
        print("removed")


def cmd_status(args):
    st = load_state()["lastSync"]
    print(f"{'ok' if st['ok'] else 'error'}: {st['message']} ({st['at'] or 'never'})")


def cmd_which(args):
    for backend, path in (("git repo", GIT_DIR), ("git store", STORE),
                          ("drive store", GDRIVE_STORE), ("state", STATE_FILE),
                          ("baselines", BASELINE_DIR), ("trash", TRASH_DIR),
                          ("conflicts", CONFLICTS_DIR)):
        print(f"{backend}: {to_tilde(path)}")


def cmd_repos(args):
    print(json.dumps(find_repos(), indent=2))


# --- entry -----------------------------------------------------------------

# Flags and subcommands 0.1.0 accepted, and what to use instead. A sync tool
# should not quietly ignore a flag someone typed expecting it to matter.
LEGACY_FLAGS = {
    "--download": "run `configsync download`, or just `configsync sync`, which does both sides",
    "--deploy": "run `configsync deploy`, or just `configsync sync`",
    "--delete": "run `configsync set-backend gdrive delete true|false`",
    "--update": "it is always on: only files that changed on one side are copied",
    "--auto": "run `configsync set-backend watch enabled true`",
    "--interval": "run `configsync set-backend watch pull <minutes>`",
    "--paths": "the paths live in `configsync state`",
}

LEGACY_COMMANDS = {
    "set-gdrive": "run `configsync set-backend gdrive remote <folder>`",
    "set-git": "run `configsync set-backend git remote <url>`",
    "set-auto": "run `configsync set-backend watch enabled true|false`",
    "panel-state": "run `configsync state`",
    "pull": "run `configsync download`",
    "push": "run `configsync deploy`",
    "set-software": "run `configsync set-secrets <id> true` for key files",
}


def main(argv=None):
    # 0.1.0 spelled several things differently. Say what replaced them instead
    # of failing with argparse's "unrecognized arguments".
    words = list(argv if argv is not None else sys.argv[1:])
    if words and words[0] in LEGACY_COMMANDS:
        sys.exit(f"{words[0]} was removed: {LEGACY_COMMANDS[words[0]]}")
    for word in words:
        flag = word.split("=", 1)[0]
        if flag in LEGACY_FLAGS:
            sys.exit(f"{flag} was removed: {LEGACY_FLAGS[flag]}")
    parser = argparse.ArgumentParser(prog="configsync", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("scan", help="detect installed apps and merge into state")

    sub.add_parser("state", help="print the whole state as JSON")
    sub.add_parser("status", help="print the last sync result")
    sub.add_parser("which", help="print the paths this tool uses")
    sub.add_parser("repos", help="list git repositories on the machine").set_defaults(func=cmd_repos)

    p = sub.add_parser("set-enabled", help="turn syncing for one app on/off")
    p.add_argument("id")
    p.add_argument("value", choices=["true", "false"])
    p.set_defaults(func=cmd_set_enabled)

    p = sub.add_parser("set-target", help="send one app to git, gdrive or none")
    p.add_argument("id")
    p.add_argument("value")
    p.set_defaults(func=cmd_set_target)

    p = sub.add_parser("set-secrets",
                       help="allow key/token files inside one item (default: skipped)")
    p.add_argument("id")
    p.add_argument("value", choices=["true", "false"])
    p.set_defaults(func=cmd_set_secrets)

    p = sub.add_parser("set-backend", help="configure a backend (remote, branch, ...)")
    p.add_argument("backend")
    p.add_argument("key")
    p.add_argument("value")
    p.set_defaults(func=cmd_set_backend)

    p = sub.add_parser("set-all", help="turn every app on or off at once")
    p.add_argument("value", choices=["true", "false"])
    p.set_defaults(func=cmd_set_all)

    p = sub.add_parser("sync", help="sync the enabled apps (both directions)")
    p.add_argument("ids", nargs="*", help="only these app ids (default: all enabled)")
    p.add_argument("--only", choices=["git", "gdrive"])
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--prefer", choices=["local", "remote"],
                   help="only decides a first-sync disagreement")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("watch", help="the rsw watchers and the periodic pass")
    p.add_argument("--on", action="store_true", help="watch every enabled path")
    p.add_argument("--off", action="store_true", help="stop watching")
    p.add_argument("--ensure", action="store_true",
                   help="start the watchers that are missing, stop stale ones")
    p.add_argument("--stop", action="store_true", help="stop our own watchers")
    p.add_argument("--all", action="store_true",
                   help="with --stop: stop every watcher, like dsw")
    p.add_argument("--once", action="store_true",
                   help="one full three-way pass, then exit (what the timer runs)")
    p.add_argument("--force", action="store_true", help="with --once: run even when watch is off")
    p.add_argument("--status", action="store_true", help="JSON for the panel")
    p.set_defaults(func=cmd_watch)

    p = sub.add_parser("service", help="manage the systemd user timer")
    p.add_argument("action", choices=["install", "uninstall", "status"])
    p.set_defaults(func=cmd_service)

    p = sub.add_parser("snapshot",
                       help="named points of the synced config: rename, go back to")
    p.add_argument("action", nargs="?", default="list",
                   choices=["create", "list", "rename", "resume", "drop"])
    p.add_argument("name", nargs="?", help="the snapshot name (or 'latest')")
    p.add_argument("new_name", nargs="?", help="the new name, for rename")
    p.add_argument("--all", action="store_true",
                   help="include the automatic pre-resume points")
    p.add_argument("--json", action="store_true", help="for the panel")
    p.add_argument("--dry-run", action="store_true",
                   help="resume: say what would move, change nothing")
    p.add_argument("--yes", action="store_true", help="resume: do not ask")
    p.set_defaults(func=cmd_snapshot)

    p = sub.add_parser("trash", help="list, restore or empty what a sync removed")
    p.add_argument("action", choices=["list", "restore", "restore-all", "empty"],
                   nargs="?", default="list")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(func=cmd_trash)

    p = sub.add_parser("conflicts",
                       help="list the local conflict copies, or prune the old ones")
    p.add_argument("action", choices=["list", "prune", "empty"],
                   nargs="?", default="list")
    p.add_argument("--keep", type=int, default=1,
                   help="copies to keep per file (default: 1, the newest)")
    p.set_defaults(func=cmd_conflicts)

    p = sub.add_parser("download", help="fetch the git backend into the local store")
    p.set_defaults(func=cmd_download)

    p = sub.add_parser("deploy", help="write the backend copy into $HOME (recovery)")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_deploy)

    p = sub.add_parser("reset", help="reset the plugin state to defaults")
    p.add_argument("--purge", action="store_true", help="also delete local repos/stores")
    p.set_defaults(func=cmd_reset)

    p = sub.add_parser("add", help="add a file or folder of your own to sync")
    p.add_argument("path")
    p.add_argument("--name")
    p.add_argument("--id")
    p.add_argument("--target", choices=["git", "gdrive"], default="git")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("remove", help="stop syncing an app or custom path")
    p.add_argument("id")
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("capture-software", help="record installed plugins and packages")
    p.set_defaults(func=cmd_capture_software)

    p = sub.add_parser("install-software", help="reinstall plugins and packages from the manifest")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--plan", action="store_true", help="print what would be installed")
    p.add_argument("--yes", action="store_true", help="install without a terminal prompt")
    p.set_defaults(func=cmd_install_software)

    args = parser.parse_args(argv)
    if not hasattr(args, "func"):
        args.func = {"scan": cmd_scan, "state": cmd_state, "status": cmd_status,
                     "which": cmd_which}[args.cmd]
    try:
        result = args.func(args)
        return result or 0
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        return 0
    except Exception as exc:  # noqa: BLE001
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
